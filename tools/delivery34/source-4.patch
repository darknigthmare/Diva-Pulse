+'use strict';
+const test=require('node:test'),assert=require('node:assert/strict');
+require('../src/core.js');require('../src/services.js');
+const M=require('../src/media-vault.js'),L=require('../src/live-feedback34.js'),F=require('../src/feedback33.js');
+const {Store}=globalThis.PulseServices;
+const asset=(id,name=id)=>({id,name,kind:'audio',blob:new Blob([new Uint8Array([1,2,3])],{type:'audio/wav'})});
+const snapshot=()=>({songs:[],settings:[],scores:[],assets:[asset('keep'),asset('free')]});
+for(const [label,row] of [
+ ['audio',{audioAsset:'keep'}],['video',{videoAsset:'keep'}],['GLB',{scene:{modelAsset:'keep'}}],
+ ['pack MMD',{scene:{mmd:{assetIds:['keep'],files:[{id:'keep'}]}}}],
+ ['Director',{director:{slots:[{modelAssetId:'keep',clips:[{motionAssetId:'keep'}]}]}}],
+ ['voix guide',{track:{sourceAsset:'keep'}}],['champ futur',{future:{anyKey:['keep']}}]
+])test('V34 reachability protects '+label,()=>{const s=snapshot();s.songs=[{id:'s',...row}];const r=M.inspect(s);assert.deepEqual(r.orphans.map(x=>x.id),['free']);assert.equal(r.protectedCount,1);assert.equal(r.totalBytes,6);});
+for(const name of ['songs','settings','scores'])test('V34 unknown references in '+name+' are retained conservatively',()=>{const s=snapshot();s[name]=[{id:'item',futureRef:'keep'}];assert.deepEqual(M.inspect(s).orphans.map(a=>a.id),['free']);});
+test('V34 unsaved in-memory recoveries are roots without changing them',()=>{const s=snapshot(),extra=[{director:{slots:[{motionAssetId:'keep'}]}}],before=structuredClone(extra);assert.deepEqual(M.inspect(s,extra).orphans.map(a=>a.id),['free']);assert.deepEqual(extra,before);});
+for(const value of [{audioAsset:'gone'},{scene:{mmd:{assetIds:['gone']}}},{track:{sourceAsset:'gone'}}])test('V34 missing reference prevents cleanup: '+JSON.stringify(value),()=>{const s=snapshot();s.settings=[value];const r=M.inspect(s);assert.equal(r.issues[0].id,'gone');assert.throws(()=>M.selection(r,['free']),/Références/);});
+for(const [name,fn]of [['duplicate id',s=>s.assets.push(asset('keep'))],['absent store',s=>delete s.scores],['invalid id',s=>s.assets.push(asset(''))],['malformed refs',s=>s.settings.push({assetIds:42})],['bad reference',s=>s.settings.push({audioAsset:{id:'keep'}})],['depth',s=>{let p={};s.settings.push(p);for(let i=0;i<90;i++)p=p.next={};}]])test('V34 malformed '+name+' fails closed',()=>{const s=snapshot();fn(s);assert.throws(()=>M.inspect(s));});
+test('V34 invalid binary content is reported, not offered for deletion',()=>{const s=snapshot();s.assets[0].blob={size:3};const r=M.inspect(s);assert.equal(r.issues.length,1);assert.ok(!r.orphans.some(a=>a.id==='keep'));});
+test('V34 cyclic roots terminate without changing ownership',()=>{const s=snapshot(),r={id:'s',audioAsset:'keep'};r.self=r;s.songs.push(r);assert.deepEqual(M.inspect(s).orphans.map(a=>a.id),['free']);});
+for(const ids of [[],['keep','keep'],['unknown'],[null]])test('V34 invalid selection rejected: '+JSON.stringify(ids),()=>assert.throws(()=>M.selection(M.inspect(snapshot()),ids)));
+async function storeWithAssets(){const s=new Store();await s.atomic([['assets',asset('keep')],['assets',asset('free')],['songs',{id:'s',audioAsset:'keep'}]]);return s;}
+test('V34 explicit cleanup deletes selected orphan only and emits after success',async()=>{const s=await storeWithAssets(),v=new M.Vault(s),r=await v.review(),events=[];s.watch(e=>events.push(e));const out=await v.clean(r,['free']);assert.deepEqual(out,{deleted:['free'],bytes:3});assert.ok(await s.get('assets','keep'));assert.equal(await s.get('assets','free'),undefined);assert.deepEqual(events.map(e=>e.type),['commit','delete']);v.dispose();});
+test('V34 new committed reference invalidates the review',async()=>{const s=await storeWithAssets(),v=new M.Vault(s),r=await v.review();await s.put('settings',{id:'draft',sourceAsset:'free'});await assert.rejects(v.clean(r,['free']),/périmée/);assert.ok(await s.get('assets','free'));v.dispose();});
+test('V34 new runtime reference aborts complete selection even without a store event',async()=>{const s=await storeWithAssets(),extra=[],v=new M.Vault(s,()=>extra),r=await v.review();extra.push({futureRef:'free'});await assert.rejects(v.clean(r,['free']),/modifiée/);assert.ok(await s.get('assets','free'));v.dispose();});
+test('V34 fresh transaction recheck refuses changes bypassing UI cache',async()=>{const s=await storeWithAssets(),v=new M.Vault(s),r=await v.review();s.memory.songs.set('new',{id:'new',videoAsset:'free'});await assert.rejects(v.clean(r,['free']),/modifiée/);assert.ok(await s.get('assets','free'));v.dispose();});
+test('V34 media replacement invalidates reviewed metadata',async()=>{const s=await storeWithAssets(),v=new M.Vault(s),r=await v.review();s.memory.assets.set('free',asset('free','replacement'));await assert.rejects(v.clean(r,['free']),/modifiée/);assert.ok(await s.get('assets','free'));v.dispose();});
+test('V34 report from another vault cannot authorize deletion',async()=>{const s=await storeWithAssets(),v=new M.Vault(s),other=new M.Vault(s);await assert.rejects(v.clean(r=await other.review(),['free']),/périmée/);v.dispose();other.dispose();});
+test('V34 read-only writer lease cannot collect assets',async()=>{const s=await storeWithAssets(),v=new M.Vault(s),r=await v.review();s.persistent=true;s.readOnly=true;await assert.rejects(v.clean(r,['free']),{code:'PULSE_READ_ONLY'});assert.ok(s.memory.assets.has('free'));v.dispose();});
+test('V34 double submission of a successful review is refused',async()=>{const s=await storeWithAssets(),v=new M.Vault(s),r=await v.review();await v.clean(r,['free']);await assert.rejects(v.clean(r,['free']),/périmée/);v.dispose();});
+test('V34 native abort never emits successful deletion or mutates cache',async()=>{const s=await storeWithAssets(),v=new M.Vault(s),r=await v.review(),events=[];s.watch(e=>events.push(e));s.db={transaction(){const tx={error:Error('Native abort'),objectStore(name){return {getAll(){const req={};queueMicrotask(()=>{req.result=[...s.memory[name].values()];req.onsuccess();});return req;},delete(){queueMicrotask(()=>tx.onabort());}};},abort(){queueMicrotask(()=>tx.onabort());}};return tx;}};await assert.rejects(v.clean(r,['free']),/Native abort/);assert.deepEqual(events.map(e=>e.type),['write-error']);assert.ok(s.memory.assets.has('free'));v.dispose();});
+const engine=()=>({activeHolds:new Map([[0,{note:{id:'h'},start:1,end:5}],[2,{note:{id:'h2'},start:2,end:6}]])});
+test('V34 gauges follow live hold time without writing engine state',()=>{const e=engine(),copy=structuredClone(e);assert.deepEqual(L.holds(e,3).map(h=>h.progress),[.5,.25]);assert.deepEqual(e,copy);});
+for(const time of [NaN,Infinity,-1,7])test('V34 no gauge for invalid or out-of-range time '+time,()=>assert.deepEqual(L.holds(engine(),time),[]));
+test('V34 invalid or ended holds do not leak progress widgets',()=>{const e=engine();e.activeHolds.set(1,{start:2,end:2,note:{}});e.activeHolds.set(9,{start:1,end:5,note:{}});assert.deepEqual(L.holds(e,5).map(h=>h.lane),[2]);});
+function context(){let count=0;return {state:'running',sampleRate:48000,currentTime:0,createBuffer(){count++;return {copyToChannel(){}};},createBufferSource(){return {connect(){},disconnect(){},start(){},stop(){}};},createGain(){return {gain:{value:0},connect(){},disconnect(){}};},get allocations(){return count;}};}
+test('V34 sound prewarming is silent and avoids first-hit buffer allocations',()=>{const ctx=context(),audio={ctx,sfxGain:{},sfxVolume:.2},b=new F.SoundBank(audio);assert.ok(b.prewarm({sfxStyle:'soft'})>0);const before=ctx.allocations;assert.equal(b.voices.size,0);assert.equal(b.stats.played,0);b.play({rating:'COOL',note:{lane:2,type:'tap'}},{sfxStyle:'soft'});assert.equal(ctx.allocations,before);assert.equal(b.stats.played,1);});
+test('V34 prewarm cache stays bounded across every timbre and lane',()=>{const ctx=context(),b=new F.SoundBank({ctx});for(const sfxStyle of F.STYLES)b.prewarm({sfxStyle});assert.ok(b.cache.size<=F.MAX_CACHE);assert.equal(b.voices.size,0);});
+test('V34 replacing audio context releases capped stale voices before judging capacity',()=>{const a={ctx:context(),sfxGain:{},sfxVolume:.2},b=new F.SoundBank(a);for(let i=0;i<12;i++)assert.ok(b.play({rating:'COOL'},{sfxStyle:'pulse'}));a.ctx=context();assert.ok(b.play({rating:'COOL'}));assert.equal(b.voices.size,1);assert.equal(b.context,a.ctx);});
+test('V34 suspended audio cannot prewarm or play a feedback sound',()=>{const ctx=context();ctx.state='suspended';const b=new F.SoundBank({ctx,sfxGain:{},sfxVolume:.2});assert.equal(b.prewarm(),0);assert.equal(b.play({rating:'COOL'}),false);assert.equal(ctx.allocations,0);});
+
+test('V34 MMD file descriptor without assetIds is still checked',()=>{const s=snapshot();s.songs=[{id:'s',scene:{mmd:{files:[{id:'missing-texture'}]}}}];assert.equal(M.inspect(s).issues[0].id,'missing-texture');});
+test('V34 live root collector includes every persisted recovery family',()=>{const roots=M.roots({songs:[],directorRecoveries:new Map([['s',{sourceAsset:'keep'}]]),faceRecoveries:new Map([['s',{sourceAsset:'free'}]]),physicsRecoveries:new Map()});assert.equal(M.inspect(snapshot(),roots).orphans.length,0);});
